DATABASE_URL=postgresql://chatflow:chatflow@db:5432/chatflow
REDIS_URL=redis://redis:6379
PORT=3333
PUBLIC_PANEL_URL=http://localhost:3000
# gere com: openssl rand -base64 32
MASTER_KEY=
# gere com: openssl rand -base64 48
JWT_SECRET=
# segredo que a Evolution envia no header x-webhook-secret
WEBHOOK_SECRET=
# fallback se nenhuma integração EVOLUTION estiver cadastrada no painel
EVOLUTION_URL=
EVOLUTION_API_KEY=
# requisições por segundo por IP antes do bloqueio automático
MAX_RPS=20
