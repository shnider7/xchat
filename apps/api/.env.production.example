# copie para .env.production e preencha (NUNCA suba o arquivo preenchido para o GitHub)
PORT=3333
PUBLIC_PANEL_URL=https://app.seudominio.com.br
# banco NOVO e usuário NOVO no Postgres que você já tem (não use o do n8n)
DATABASE_URL=postgresql://chatflow_user:SENHA@host.docker.internal:5432/chatflow
# Redis: número de banco diferente do n8n e senha, se houver (ex.: /5)
REDIS_URL=redis://:SENHA@host.docker.internal:6379/5
MASTER_KEY=
JWT_SECRET=
WEBHOOK_SECRET=
MAX_RPS=20
SIGNUP_ENABLED=false
# email de recuperação de senha (ex.: o SMTP do seu provedor de email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ChatFlow <nao-responda@seudominio.com.br>
